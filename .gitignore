# =============================================================================
# .gitignore — ContainerExtension
# =============================================================================

# -- Security & Credentials ------------------------------------------------------
*.pem
*.key
*.cer
*.crt
*.p12
*.pfx
secrets.json
.env
.env.*
!.env.example
docker_auth.json

# -- OS Artifacts -------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*~

# -- IDEs & Editors -----------------------------------------------------------
.idea/
.vscode/
.vs/
*.user
*.suo
*.bak
*.DotSettings.user
riderModule.iml
/_ReSharper.Caches/

# -- .NET Build & Tooling -----------------------------------------------------
bin/
obj/
publish/
publish_debug/
publish_new/
/packages/
native_tools/
*.nupkg
project.assets.json
*.nuget.props
*.nuget.targets
*.nuget.g.props
*.nuget.g.targets

# .NET Local Tooling
.dotnet_cli_home/
.dotnet_home/
.nuget_packages/
.nuget_scratch/
.tmp/
.tmp.nosync/
*.nosync
Library/

# -- Quality & Security Scans ----------------------------------------------------
*.sarif
TestResults/
coverage/
trivy-results.json
sbom.spdx.json
StrykerOutput/


# -- DocFX (Generated Documentation) ------------------------------------------
_site/
docs/api/*.yml
docs/api/.manifest
docs/api/toc.yml

# -- Logs & Debugging ---------------------------------------------------------
full_source_bundle.md
*.log

# -- Avalonia UI Previewer & Caches --------------------------------------------
.avalonia/
preview/
*.preview.html
.avalonia-preview/
artifacts/preview/
*.designer.cs
*.ide/

