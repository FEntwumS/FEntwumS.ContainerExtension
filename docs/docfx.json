{
    "metadata": [
        {
            "src": [
                {
                    "files": [
                        "../src/ContainerExtension/ContainerExtension.csproj"
                    ],
                    "src": "."
                }
            ],
            "dest": "api",
            "includePrivateMembers": false,
            "disableGitFeatures": false,
            "disableDefaultFilter": false,
            "properties": {
                "TargetFramework": "net10.0"
            }
        }
    ],
    "build": {
        "content": [
            {
                "files": [
                    "api/**.yml",
                    "api/index.md"
                ]
            },
            {
                "files": [
                    "articles/**.md",
                    "articles/**/toc.yml",
                    "toc.yml",
                    "*.md"
                ]
            }
        ],
        "resource": [
            {
                "files": [
                    "images/**",
                    "Icon.svg"
                ]
            }
        ],
        "output": "_site",
        "globalMetadataFiles": [],
        "fileMetadataFiles": [],
        "template": [
            "default",
            "modern",
            "templates/modern"
        ],
        "globalMetadata": {
            "_appTitle": "OneWare Container Extension",
            "_appName": "Container Extension API",
            "_appLogoPath": "Icon.svg",
            "_appFaviconPath": "Icon.svg",
            "_enableSearch": true,
            "_disableContribution": false,
            "_gitContribute": {
                "repo": "https://github.com/FEntwumS/FEntwumS.ContainerExtension",
                "branch": "main",
                "apiSpecFolder": "docs/api"
            }
        },
        "markdownEngineName": "markdig",
        "dest": "_site"
    }
}
