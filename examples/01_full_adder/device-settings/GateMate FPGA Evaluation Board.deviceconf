{
  "cologneChipToolchainType": "GateMate FPGA Evaluation Board",
  "cologneChipProgrammerShortTermMode": "JTAG",
  "cologneChipProgrammerLongTermMode": "JTAG",
  "cologneChipProgrammerType": "EVB",
  "yosysToolchainYosysSynthTool": "synth_gatemate",
  "yosysToolchainCommand": "plugin -i ghdl; ghdl --std=08 full_adder.vhd -e $TOP; $SYNTH_TOOL -top $TOP -luttree -nomx8; write_json $OUTPUT",
  "yosysToolchainNextPnrTool": "nextpnr-himbaechel",
  "yosysToolchainNextPnrFlags": "--device=CCGM1A1 --router router2 --vopt allow-unconstrained",
  "yosysToolchainConstraintFileType": "ccf",
  "yosysToolchainOutputType": "txt",
  "yosysToolchainPackTool": "gmpack",
  "packToolOutputFormat": "bit",
  "openFpgaLoaderBoard": "gatemate_evb_jtag",
  "openFpgaLoaderBitstreamFormat": "bit"
}
