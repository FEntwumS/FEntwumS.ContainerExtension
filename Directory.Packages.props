<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning is disabled in local mode (UseLocalEssentials=true): the local
         OneWare.Essentials checkout pulls newer transitive versions (e.g. Avalonia 11.3.18) than the
         central pins here, and pinning would downgrade them to a conflict (NU1109). -->
    <CentralPackageTransitivePinningEnabled Condition="'$(UseLocalEssentials)' != 'true'">true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.294">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Compile-time only (ExcludeAssets=runtime;Native): the OneWare host supplies the runtime
         assembly, and its plugin loader rejects the plugin on a host older than this pin. 1.0.40 is
         the first Essentials with the tool-execution strategy members DockerExecutionStrategy
         implements (StartProcess, StopProcess, IsProcessRunning), so it is the oldest pin that
         compiles; a newer pin would only lock out 1.0.40 hosts. The Avalonia pins above follow the
         floor this version sets (11.3.22). A release built on this pin needs "minStudioVersion" in
         its oneware-extension.json entry, so older hosts are not offered it. Dependabot-ignored;
         bump manually and re-run the OneWare side-load load test (a clean build does not prove it loads). -->
    <PackageVersion Include="OneWare.Essentials" Version="1.0.40" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <!-- Pinned to the version OneWare bundles (10.0.0): OneWare's plugin loader rejects a plugin
         that REQUIRES a newer transitive dependency than the host provides, so a Dependabot bump here
         silently breaks plugin loading at runtime (compiles and tests fine). Do not raise without
         confirming the OneWare host provides at least the new version. -->
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>