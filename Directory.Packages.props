<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="11.3.17" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.138">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Compile-time only (ExcludeAssets=runtime;Native): the OneWare host supplies the runtime
         assembly. Pin to the newest Essentials on NuGet that does not exceed the targeted host, or the
         plugin loader rejects the plugin. 1.0.20/1.0.21/1.0.23 are host git tags only (absent from
         NuGet), so 1.0.22 is the newest publishable pin for the 1.0.23 host. Dependabot-ignored;
         bump manually and re-run the OneWare side-load load test (a clean build does not prove it loads). -->
    <PackageVersion Include="OneWare.Essentials" Version="1.0.22" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.31.0.145097">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <!-- Pinned to the version OneWare bundles (10.0.0): OneWare's plugin loader rejects a plugin
         that REQUIRES a newer transitive dependency than the host provides, so a Dependabot bump here
         silently breaks plugin loading at runtime (compiles and tests fine). Do not raise without
         confirming the OneWare host provides at least the new version. -->
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>