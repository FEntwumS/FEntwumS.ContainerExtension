{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Harness: run ghdl command",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "program": "${workspaceFolder}/src/ContainerBenchmarkHarness/bin/Debug/net10.0/ContainerBenchmarkHarness.dll",
            "args": [ "ghdl", "--version" ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Harness: stress-telemetry",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "program": "${workspaceFolder}/src/ContainerBenchmarkHarness/bin/Debug/net10.0/ContainerBenchmarkHarness.dll",
            "args": [ "stress-telemetry", "--processes", "2", "--threads", "4", "--iterations", "10" ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Attach to OneWare Studio",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "requireExactSource": false
        }
    ]
}
