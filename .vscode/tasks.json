{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OneWare.ContainerExtension.slnx",
                "-c", "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build (Release)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OneWare.ContainerExtension.slnx",
                "-c", "Release",
                "-warnaserror",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/OneWare.ContainerExtension.slnx",
                "--verbosity", "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Security: Trivy Scan Dockerfile",
            "command": "trivy",
            "type": "process",
            "args": [
                "config",
                "${workspaceFolder}/docker/oss-cad-suite/"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/OneWare.ContainerExtension.slnx"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
