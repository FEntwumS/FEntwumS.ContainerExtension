# Exclude dotnet build outputs
**/bin/
**/obj/
**/publish/
**/publish_debug/

# Exclude non-synced build/scratch state
.tmp.nosync/
*.nosync

# Exclude IDE and workspace settings
.idea/
.vs/
.vscode/
.gemini/
*.user
*.suo
_ReSharper.Caches/

# Exclude version control metadata
.git/
.gitignore
.gitattributes
.gitmodules

# Exclude local configuration and secrets
.env
.env.*
secrets.json
docker_auth.json
*.pem
*.key
*.cer
*.crt

# Exclude telemetry and logs
*.log
trivy-results.json
sbom.spdx.json
*.sarif
TestResults/
coverage/

# Exclude tests and benchmarking harness (fixtures, integration scripts, unit tests)
tests/
__pycache__/
.DS_Store
