# =============================================================================
# Git Attributes — Line Endings & Export Rules
# =============================================================================

# -- Default ------------------------------------------------------------------
* text=auto eol=lf

# -- Source Code --------------------------------------------------------------
*.cs        text diff=csharp
*.py        text diff=python
*.xml       text
*.json      text
*.jsonl     text
*.yml       text
*.yaml      text
*.md        text diff=markdown
*.txt       text
*.css       text
*.html      text diff=html

# -- .NET Project Files -------------------------------------------------------
*.csproj    text eol=lf
*.slnx      text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=lf

# -- Shell / Config -----------------------------------------------------------
*.sh        text eol=lf
Dockerfile  text eol=lf
.editorconfig text eol=lf
.dockerignore text eol=lf
.gitignore  text eol=lf
.gitmodules text eol=lf
.env        text merge=ours eol=lf

# -- Security & Auditing ------------------------------------------------------
*.sarif     text
*.spdx.json text

# -- Export Ignores (Exclude from release zip) --------------------------------
.github/    export-ignore
tests/      export-ignore
docs/       export-ignore
.gitignore  export-ignore

# -- Binary / Media (never touch line endings) --------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.nupkg     binary
*.zip       binary
*.gz        binary
*.tar       binary
*.pem       binary
*.key       binary

# -- GitHub Linguist Overrides ------------------------------------------------
tests/benchmarking_suite/neorv32/**          linguist-vendored
tests/benchmarking_suite/picorv32/**         linguist-vendored
docker/oss-cad-suite/oss-cad-suite-build/**  linguist-vendored
**/api/**                                    linguist-generated
**/_site/**                                  linguist-generated
