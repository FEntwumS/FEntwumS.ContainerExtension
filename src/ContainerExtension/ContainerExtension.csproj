<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.0.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <SelfContained>false</SelfContained>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ContainerExtension.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**\*.*"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OneWare.Essentials" Private="false" ExcludeAssets="runtime;Native" />
        <PackageReference Include="Docker.DotNet" Private="true" />
    </ItemGroup>

    <Target Name="GenerateCompatibilityFile" AfterTargets="Build">
        <Delete Files="$(OutDir)compatibility.txt" />
        <!-- Call the batching target -->
        <CallTarget Targets="_AppendCompatLine" />
    </Target>

    <Target Name="_AppendCompatLine" Outputs="%(PackageReference.Identity)">
        <PropertyGroup>
            <_PkgId>%(PackageReference.Identity)</_PkgId>
            <_PkgVer>%(PackageReference.Version)</_PkgVer>
            <_PkgVer Condition="'$(_PkgVer)' == ''">%(PackageReference.VersionOverride)</_PkgVer>
        </PropertyGroup>
        <ItemGroup>
            <_MatchedPackageVersion Include="@(PackageVersion)" Condition="'%(Identity)' == '$(_PkgId)'" />
        </ItemGroup>
        <PropertyGroup>
            <_PkgVer Condition="'$(_PkgVer)' == ''">%(_MatchedPackageVersion.Version)</_PkgVer>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(OutDir)compatibility.txt"
            Lines="$(_PkgId) : $(_PkgVer)"
            Overwrite="false"
            Condition="'$(_PkgId)' != '' and '%(PackageReference.Private)' != 'true' and '%(PackageReference.PrivateAssets)' != 'all'" />
    </Target>

    <Target Name="CopyCompatibilityFile" AfterTargets="Publish">
        <Copy SourceFiles="$(OutDir)compatibility.txt" DestinationFolder="$(PublishDir)" />
    </Target>

</Project>
